{
  "name": "@yjy233/kraken",
  "version": "0.1.0",
  "description": "Kraken AI Assistant - A powerful AI coding assistant CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kraken": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "Kraken.json",
    "kraken.schema.json"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bot": "tsx src/lark/start-bot.ts",
    "bot:debug": "DEBUG=lark tsx src/lark/start-bot.ts",
    "bot:inspect": "DEBUG=lark:* tsx src/lark/start-bot.ts --inspect",
    "bot:verbose": "DEBUG=* tsx src/lark/start-bot.ts",
    "bot:build": "npm run build && node dist/lark/start-bot.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "assistant",
    "cli",
    "coding",
    "llm",
    "openai",
    "claude",
    "agent",
    "react",
    "lark",
    "feishu"
  ],
  "author": "yjy233",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjy233/kraken.git"
  },
  "bugs": {
    "url": "https://github.com/yjy233/kraken/issues"
  },
  "homepage": "https://github.com/yjy233/kraken#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@tavily/core": "^0.7.1",
    "dotenv": "^16.4.5",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

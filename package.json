{
  "bin": {
    "kraken": "dist/index.js"
  },
  "name": "kraken-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bot": "tsx src/lark/start-bot.ts",
    "bot:debug": "DEBUG=lark tsx src/lark/start-bot.ts",
    "bot:inspect": "DEBUG=lark:* tsx src/lark/start-bot.ts --inspect",
    "bot:verbose": "DEBUG=* tsx src/lark/start-bot.ts",
    "bot:build": "npm run build && node dist/lark/start-bot.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@tavily/core": "^0.7.1",
    "dotenv": "^16.4.5",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}

{
  "protocol": "openai",
  "model": "",
  "summaryModel": "",
  "baseUrl": "",
  "openAIApiKey": "",
  "maxIterations": 36,
  "contextWindow": 128000,
  "workspaceRoot": "",
  "allowNetwork": true,
  "maxToken": 64000,
  "compression": {
    "enabled": true, 
    "contextWindow": 128000,
    "model": "",
    "threshold": 0.5,
    "maxAllowedPercentage": 0.9
  },
  "mcp": {
    "enabled": false,
    "servers": [
      {
        "name": "filesystem",
        "description": "文件系统操作 - 读写本地文件 (stdio)",
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "~/code"],
        "enabled": false
      }
    ]
  },
  "lark": {
    "enabled": true,
    "appId": "",
    "appSecret": "",
    "debug": false,
    "autoReplyOnMention": true,
    "botKeywords": ["kraken", "机器人"],
    "welcomeMessage": "你好！我是 Kraken AI 助手",
    "systemPrompt": null
  },
  "tools": {
    "enabled": true,
    "tavily": {
      "enabled": true,
      "allowNetwork": true,
      "apiKey": ""
    }
  }
}
